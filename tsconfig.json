{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "types": ["node"],
    "paths": {
      //Player
      "@aircraft/*": ["./src/player/aircraft/*"],
      "@tasks/*": ["./src/player/tasks/*"],
      "@moving/*": ["./src/player/moving/*"],
      "@resources/*": ["./src/player/resources/*"],
      "@roads/*": ["./src/player/roads/*"],
      "@workers/*": ["./src/player/workers/*"],
      //Ui
      "@camera/*": ["./src/ui/camera/*"],
      "@compass/*": ["./src/ui/compass/*"],
      "@construction/*": ["./src/ui/construction/*"],
      "@header/*": ["./src/ui/header/*"],
      "@joystick/*": ["./src/ui/joystick/*"],
      "@pause/*": ["./src/ui/pause/*"],
      "@speed/*": ["./src/ui/speed/*"],
      "@research/*": ["./src/ui/research/*"],
      "@shooting/*": ["./src/ui/shooting/*"],
      "@tutorial/*": ["./src/ui/tutorial/*"],
      //World
      "@background/*": ["./src/world/background/*"], 
      "@islands/*": ["./src/world/islands/*"],
      "@objects/*": ["./src/world/objects/*"],
      //Other
      "@utils/*": ["./src/utils/*"],
      "@test-situations/*": ["./src/test-situations/*"],
      "@test-scenarios/*": ["./tests/scenarios/*"],
      "@test-infra/*": ["./tests/test-infra/*"],
    }
  }
}