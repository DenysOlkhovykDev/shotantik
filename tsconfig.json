{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "types": ["node"],
    "paths": {
      "@aircraft/*": ["./src/aircraft/*"],
      "@background/*": ["./src/background/*"],
      "@moving/*": ["./src/moving/*"],
      "@dashboard/*": ["./src/dashboard/*"],
      "@islands/*": ["./src/islands/*"],
      "@on-ground/*": ["./src/on-ground/*"],
      "@resources/*": ["./src/resources/*"],
      "@compass/*": ["./src/ui/compass/*"],
      "@construction/*": ["./src/ui/construction/*"],
      "@header/*": ["./src/ui/header/*"],
      "@joystick/*": ["./src/ui/joystick/*"],
      "@pause/*": ["./src/ui/pause/*"],
      "@speed/*": ["./src/ui/speed/*"],
      "@research/*": ["./src/ui/research/*"],
      "@tutorial/*": ["./src/ui/tutorial/*"],
      "@roads/*": ["./src/roads/*"],
      "@utils/*": ["./src/utils/*"],
      "@workers/*": ["./src/workers/*"],
      "@test-situations/*": ["./src/test-situations/*"],
      "@test-scenarios/*": ["./tests/scenarios/*"],
      "@test-infra/*": ["./tests/test-infra/*"],
    }
  }
}